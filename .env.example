# TunTunShu 环境变量示例
# 复制为 .env 后按需修改:cp .env.example .env

# ── 必填 ──────────────────────────────────────────────

# 主鉴权密钥:用于后台登录,同时作为代理接口(/v1/*)的默认 API Key。
# 缺失时服务启动即抛错,请设置为足够随机的强密钥。
AUTH_KEY=change-me-to-a-strong-secret

# PostgreSQL 连接串(DSN)。缺失时服务启动即抛错。
DATABASE_DSN=postgres://user:password@localhost:5432/tuntunshu

# ── 可选(下面为默认值)──────────────────────────────────

# HTTP 监听地址,默认 0.0.0.0
HOST=0.0.0.0

# HTTP 监听端口,默认 4025
PORT=4025

# 时区,默认 Asia/Shanghai
# 注意:Deno.cron 的定时任务一律按 UTC 解释,此 TZ 不影响 cron 调度。
TZ=Asia/Shanghai
