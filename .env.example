# TunTunShu 环境变量示例
# 复制为 .env 后按需修改:cp .env.example .env

# ── 必填 ──────────────────────────────────────────────

# 主鉴权密钥:用于后台登录,同时作为代理接口(/v1/*)的默认 API Key。
# 缺失时服务启动即抛错,请设置为足够随机的强密钥。
AUTH_KEY=change-me-to-a-strong-secret

# PostgreSQL 连接串(DSN)。缺失时服务启动即抛错。
DATABASE_DSN=postgres://user:password@localhost:5432/tuntunshu

# ── 可选(下面为默认值)──────────────────────────────────

# HTTP 监听地址,默认 0.0.0.0
HOST=0.0.0.0

# HTTP 监听端口,默认 4025
PORT=4025

# 时区,默认 Asia/Shanghai
# 注意:Deno.cron 的定时任务一律按 UTC 解释,此 TZ 不影响 cron 调度。
TZ=Asia/Shanghai

# CloakBrowser Free / Pro 许可证。GitHub Free Key 使用 latest stable；
# 留空时使用 wrapper 0.5.10 自带的免许可证 legacy Chromium 146。
# Deno Deploy 若要构建 latest stable，需在 Build 与 Production 环境同时配置。
CLOAKBROWSER_LICENSE_KEY=

# 可选:跳过构建产物中的内置 CloakBrowser,改用这个本机 Chromium 可执行文件。
CLOAKBROWSER_BINARY_PATH=

# 可选:固定一个完整 Chromium 版本号,供免费或付费版本回滚、复现；Deploy 的
# Build 与 Production 环境应保持一致。
CLOAKBROWSER_VERSION=
